# Optional configuration for hosts that implement _headers; GitHub Pages ignores it.
# The Pages site enforces its CSP and referrer policy through BaseLayout.astro.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; frame-src 'none'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: no-store

/pagefind/*
  Cache-Control: public, max-age=3600
