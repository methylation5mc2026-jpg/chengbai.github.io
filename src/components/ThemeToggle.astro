<button
  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-sm text-ink-600 transition hover:border-accent-500 hover:text-ink-900 dark:border-white/10 dark:text-ink-300 dark:hover:text-white"
  type="button"
  aria-label="Toggle dark mode"
  data-theme-toggle
>
  <span class="dark:hidden">◐</span>
  <span class="hidden dark:inline">◑</span>
</button>

<script>
  import { readPreference, writePreference } from "../lib/browser-preferences";

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const saved = readPreference("theme");
  if (saved === "dark") {
    root.classList.add("dark");
  }
  toggle?.setAttribute("aria-pressed", String(root.classList.contains("dark")));

  toggle?.addEventListener("click", () => {
    root.classList.toggle("dark");
    const dark = root.classList.contains("dark");
    toggle.setAttribute("aria-pressed", String(dark));
    writePreference("theme", dark ? "dark" : "light");
  });
</script>
