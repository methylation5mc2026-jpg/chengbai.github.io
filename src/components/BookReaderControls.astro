<div class="reader-controls flex items-center gap-2" aria-label="Reading settings">
  <button class="reader-control-button" type="button" data-reader-font="minus" aria-label="Decrease font size">A-</button>
  <button class="reader-control-button" type="button" data-reader-font="plus" aria-label="Increase font size">A+</button>
  <button class="reader-control-button" type="button" data-reader-width="narrow" aria-label="Narrow reading width">N</button>
  <button class="reader-control-button" type="button" data-reader-width="wide" aria-label="Wide reading width">W</button>
</div>

<script>
  import { chapterUrl, readPreference, readerNumber, writePreference } from "../lib/browser-preferences";

  (() => {
  const shell = document.querySelector<HTMLElement>("[data-reader-shell]");
  if (!shell || shell.dataset.readerReady === "true") return;
  shell.dataset.readerReady = "true";

  const progress = document.querySelector<HTMLElement>("[data-reader-progress]");
  const prevHref = chapterUrl(shell.dataset.prevChapter, import.meta.env.BASE_URL, window.location.href);
  const nextHref = chapterUrl(shell.dataset.nextChapter, import.meta.env.BASE_URL, window.location.href);
  let font = readerNumber(readPreference("reader-font"), 1.08, 0.96, 1.28);
  let width = readerNumber(readPreference("reader-width"), 74, 64, 86);

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
  const applyReaderState = () => {
    shell.style.setProperty("--reader-size", `${font}rem`);
    shell.style.setProperty("--reader-width", `${width}ch`);
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const fontButton = target.closest("[data-reader-font]");
    if (fontButton instanceof HTMLElement) {
      const delta = fontButton.dataset.readerFont === "plus" ? 0.04 : -0.04;
      font = Number(clamp(font + delta, 0.96, 1.28).toFixed(2));
      applyReaderState();
      writePreference("reader-font", String(font));
      return;
    }

    const widthButton = target.closest("[data-reader-width]");
    if (widthButton instanceof HTMLElement) {
      width = widthButton.dataset.readerWidth === "wide" ? 86 : 64;
      applyReaderState();
      writePreference("reader-width", String(width));
    }
  });

  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const value = max > 0 ? (window.scrollY / max) * 100 : 0;
    progress.style.width = `${Math.min(100, Math.max(0, value))}%`;
  };

  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.repeat) return;
    if (event.target instanceof Element && event.target.closest(
      'input, textarea, select, button, a, [contenteditable]:not([contenteditable="false"]), [role="textbox"], [role="slider"]'
    )) return;
    const href = event.key === "ArrowLeft" ? prevHref : event.key === "ArrowRight" ? nextHref : undefined;
    if (href) {
      event.preventDefault();
      window.location.assign(href);
    }
  });

  applyReaderState();
  updateProgress();
  window.addEventListener("scroll", updateProgress, { passive: true });
  window.addEventListener("resize", updateProgress);
  })();
</script>
